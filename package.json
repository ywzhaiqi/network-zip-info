{
  "name": "network-zip-info",
  "version": "2.0.0",
  "description": "通过网络 Range 请求获取 ZIP 文件信息，无需下载完整文件",
  "type": "module",
  "bin": {
    "network-zip-info": "./dist/cli.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist/**/*.mjs",
    "dist/**/*.d.mts",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "start": "node dist/cli.mjs"
  },
  "keywords": [
    "zip",
    "network",
    "range",
    "http",
    "inspection",
    "cli"
  ],
  "author": "ywzhaiqi",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.0.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "bumpp": "^10.3.2",
    "tsdown": "^0.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ywzhaiqi/network-zip-info.git"
  },
  "bugs": {
    "url": "https://github.com/ywzhaiqi/network-zip-info/issues"
  },
  "homepage": "https://github.com/ywzhaiqi/network-zip-info#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}